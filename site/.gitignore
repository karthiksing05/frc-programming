# Python virtual environment for the local MkDocs server
.venv/

# MkDocs build output (the static site)
site/

# Symlink created by serve.sh at runtime — examples/ lives elsewhere
docs/examples

# Symlink created by serve.sh at runtime — process/ lives elsewhere
docs/process

